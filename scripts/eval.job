#!/bin/bash
#SBATCH --account=jonmay_1426
#SBATCH --partition=gpu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gpus-per-task=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64GB
#SBATCH --time=00:30:00
#SBATCH --job-name=rewardbench-eval
#SBATCH --output=/project2/jonmay_1426/bandrede/reward-model/logs/%j.out
#SBATCH --error=/project2/jonmay_1426/bandrede/reward-model/logs/%j.err
#SBATCH --mail-type=BEGIN,END,FAIL
#SBATCH --mail-user=bdvinod788@gmail.com

module purge
module load conda
source activate /scratch1/bandrede/envs/reward-model

export HF_HOME=/scratch1/bandrede/hf_cache
export HF_DATASETS_CACHE=/scratch1/bandrede/datasets
export RM_PROJECT=/project2/jonmay_1426/bandrede/reward-model

DATASET=${DATASET:?Set DATASET to one of: hh, ultrafeedback, mixed (e.g. sbatch --export=DATASET=mixed eval.job)}

if [ "$DATASET" = "hh" ]; then
    CKPT_DIR=$RM_PROJECT/checkpoint
else
    CKPT_DIR=$RM_PROJECT/checkpoint_${DATASET}
fi

# Find latest checkpoint automatically
LATEST=$(ls -d $CKPT_DIR/checkpoint-* 2>/dev/null | sort -V | tail -1)
echo "Evaluating checkpoint: $LATEST"

rewardbench \
  --model $LATEST \
  --batch_size 8 \
  --not_quantized \
  --output_dir $RM_PROJECT/outputs/rewardbench_${DATASET}/$(basename $LATEST)
