#!/bin/bash
#SBATCH --account=jonmay_1426
#SBATCH --partition=gpu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gpus-per-task=a100:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64GB
#SBATCH --time=15:00:00
#SBATCH --job-name=rm-hh
#SBATCH --output=/scratch1/bandrede/reward-model/logs/%j.out
#SBATCH --error=/scratch1/bandrede/reward-model/logs/%j.err
#SBATCH --mail-type=BEGIN,END,FAIL
#SBATCH --mail-user=bdvinod788@gmail.com

module purge
module load conda
source activate /scratch1/bandrede/envs/reward-model

export HF_HOME=/scratch1/bandrede/hf_cache
export HF_DATASETS_CACHE=/scratch1/bandrede/datasets
export RM_PROJECT=/scratch1/bandrede/reward-model
export WANDB_MODE=offline

cd $RM_PROJECT
echo "Output dir: $RM_PROJECT/checkpoint_hh"

LATEST=$(ls -d $RM_PROJECT/checkpoint_hh/checkpoint-* 2>/dev/null | sort -V | tail -1)
if [ -z "$LATEST" ]; then
    echo "Starting from scratch"
    /scratch1/bandrede/envs/reward-model/bin/python src/train_ablation.py --output $RM_PROJECT/checkpoint --dataset hh
else
    echo "Resuming from $LATEST"
    /scratch1/bandrede/envs/reward-model/bin/python src/train_ablation.py --output $RM_PROJECT/checkpoint --dataset hh --resume $LATEST
fi
