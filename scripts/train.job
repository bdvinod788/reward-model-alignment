#!/bin/bash
#SBATCH --account=jonmay_1426
#SBATCH --partition=gpu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gpus-per-task=a100:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64GB
#SBATCH --time=12:00:00
#SBATCH --job-name=reward-model-train
#SBATCH --output=/project2/jonmay_1426/bandrede/reward-model/logs/%j.out
#SBATCH --error=/project2/jonmay_1426/bandrede/reward-model/logs/%j.err
#SBATCH --mail-type=BEGIN,END,FAIL
#SBATCH --mail-user=bdvinod788@gmail.com

module purge
eval "$(conda shell.bash hook)"
conda activate /scratch1/bandrede/envs/reward-model

export HF_HOME=/scratch1/bandrede/hf_cache
export HF_DATASETS_CACHE=/scratch1/bandrede/datasets
export RM_PROJECT=/project2/jonmay_1426/bandrede/reward-model

cd $RM_PROJECT
echo "Output dir: $RM_PROJECT/checkpoint"
python src/train.py --output $RM_PROJECT/checkpoint
